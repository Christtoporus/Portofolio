    "styles": {
        "spacing": {
            "blockGap": "1.2rem"
        },
        "blocks": {
            "core/post-content": {
                "spacing": {
                    "margin": {
                        "top": "0px"
                    }
                }
            },
            "core/heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--baskervville)",
                    "fontStyle": "normal",
                    "fontWeight": "400"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--albert-sans)"
                }
            }
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--baskervville)",
                    "fontStyle": "normal",
                    "fontWeight": "400"
                },
                "color": {
                    "text": "var(--wp--preset--color--gv-color-text-primary)"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--baskervville)",
                    "fontStyle": "normal",
                    "fontWeight": "400"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--gv-color-primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var:preset|color|gv-color-accent-hover"
                    }
                }
            }
        },
        "typography": {
            "fontStyle": "normal",
            "fontWeight": "400"
        },
        "color": {
            "text": "var(--wp--preset--color--gv-color-text-secondary)"
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header"
        },
        {
            "area": "footer",
            "name": "footer"
        }
    ],
